{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(curl*|*sh)",
      "Edit(./.github/workflows/**)",
      "Edit(./CODEOWNERS)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(docker*)"
    ],
    "allow": [
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(npm test*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(actionlint*)",
      "Bash(shellcheck*)",
      "Bash(bash tests/*)",
      "Bash(python3 evidence/WP-000/checks/*)",
      "Bash(python3 .claude/skills/run-verification/validate-workflows.py*)",
      "Bash(python3 scripts/check_scope.py*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
