{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env*)",
      "Read(/**/secrets/**)",
      "Read(/**/*.pem)",
      "Read(/**/id_rsa*)",
      "Bash(git push --force*)",
      "Edit(/.github/workflows/**)",
      "Edit(/CODEOWNERS)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)"
    ],
    "ask": ["Bash(git push*)"],
    "allow": ["Bash(pytest*)"]
  },
  "hooks": {
    "PostToolUse": []
  }
}
